# =============================================================================
# .env.example — plantilla de variables de entorno
# =============================================================================
# Cada var lleva una etiqueta que indica dónde debe estar seteada:
#   [Vercel + local]  requerida en producción Y en dev local
#   [Vercel only]     solo prod (dev puede quedar sin ella)
#   [Local only]      solo dev / scripts locales / GitHub Actions;
#                     NUNCA pegar en Vercel
#   [Opcional]        el código maneja el caso de estar vacía
# =============================================================================

# --- Supabase --------------------------------------------------------------
# [Vercel + local]
NEXT_PUBLIC_SUPABASE_URL=
# [Vercel + local]
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [Vercel + local]  server-side; NUNCA client
SUPABASE_SERVICE_ROLE_KEY=
# [Local only]  Postgres connection string (Transaction pooler) — solo para
# correr migrations desde scripts. Vercel no lo necesita.
DATABASE_URL=
# [Local only]  Personal Access Token para Supabase Management API. Generate:
# https://supabase.com/dashboard/account/tokens
# NEVER paste this into chat, commits, or logs. Used only via shell
# substitution (`$SUPABASE_MANAGEMENT_TOKEN`), never echo'd.
SUPABASE_MANAGEMENT_TOKEN=

# --- Mercado Pago ---------------------------------------------------------
# [Vercel + local, opcional]  Si están vacías, /p/[id]/servicios muestra la
# página pero el checkout está deshabilitado (isMercadoPagoConfigured()=false).
# Setear cuando quieras vender el informe ARBA.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Resend ---------------------------------------------------------------
# [Vercel + local]  emails transaccionales + SMTP de Supabase Auth
RESEND_API_KEY=
# [Vercel + local]  formato: 'Jotaeme <onboarding@resend.dev>'
RESEND_FROM=

# --- Sentry ---------------------------------------------------------------
# [Vercel + local, opcional]  DSN va en NEXT_PUBLIC_ para browser; SENTRY_DSN
# duplica para server. Si están vacías, Sentry queda apagado (checked with !!).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# [Vercel only, opcional]  ORG/PROJECT/AUTH_TOKEN se usan al build para subir
# source maps. Sin ellas el build igual pasa (Sentry salta el upload).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Scraping -------------------------------------------------------------
# [Local only]  El scraper corre EN LA MAQUINA DEL OWNER (`npm run pipeline`),
# no en Vercel y ya no en GitHub Actions: Zonaprop bloquea las IPs de
# datacenter de los runners. El workflow sigue en el repo y sus secrets
# cargados, pero las corridas que traen data son las locales.
SCRAPER_USER_AGENT=
SCRAPER_PROXY_URL=

# --- Geocoding ------------------------------------------------------------
# [Local only]  Igual que scraping — solo lo usan scripts / GitHub Actions.
GOOGLE_GEOCODING_API_KEY=

# --- Mapas ----------------------------------------------------------------
# [Vercel + local, muy recomendado]  Template de tiles del basemap, para los
# tres mapas del sitio (bloque de cobertura de la home, /p/[id], mapa de
# mercado). Sin esto caen a los servidores de OpenStreetMap, que son de
# voluntarios y cuya política de uso prohíbe justamente esto: pasado cierto
# ritmo devuelven, con HTTP 200, una tile que dice "Access blocked". O sea
# que el sitio se rompe sin que falle nada.
#
# CARTO y MapTiler tienen tier gratis y usan el mismo esquema de tiles. La
# key va en la URL y es pública a propósito (los mapas se dibujan en el
# navegador). Ejemplos:
#   https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?api_key=...
#   https://api.maptiler.com/maps/dataviz-light/{z}/{x}/{y}.png?key=...
# Si se apunta a otro host, agregarlo también a images.remotePatterns en
# next.config.ts. La atribución se deduce sola de la URL.
NEXT_PUBLIC_BASEMAP_URL=

# --- App ------------------------------------------------------------------
# [Vercel + local]  URL absoluta pública. En Vercel: https://<tu-dominio>.
# En dev: http://localhost:3000. Se usa para links en emails y returns de MP.
NEXT_PUBLIC_APP_URL=
# [Vercel + local, opcional]  Auth para endpoints internos (cron). Setear en
# ambos si algún endpoint /api/* lo valida.
INTERNAL_API_KEY=
